const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
const seed = [
 ['Ocean Depths',['#071952','#088395','#37B7C3','#EBF4F6','#F8FAFC']],
 ['Sunset Boulevard',['#2D1B69','#5B2A86','#D45087','#F7A8A8','#FFE6C7']],
 ['Forest Calm',['#183A1D','#4F6F52','#739072','#D2E3C8','#F5F1E8']],
 ['Nordic Minimal',['#20262E','#495867','#829191','#D5D6D2','#F4F4F2']],
 ['Electric Bloom',['#240046','#5A189A','#9D4EDD','#E0AAFF','#F7E8FF']],
 ['Warm Terracotta',['#6B2D1A','#A44A3F','#D98C5F','#E9C46A','#FAF3E0']],
 ['Cyber Night',['#090B1A','#222A68','#4B4AEF','#A855F7','#F0ABFC']],
 ['Soft Serenity',['#CDB4DB','#FFC8DD','#FFAFCC','#BDE0FE','#A2D2FF']],
 ['Golden Hour',['#472D2D','#8C4A2F','#D97736','#F2B263','#FFE8C2']],
 ['Monochrome',['#111111','#3D3D3D','#777777','#BDBDBD','#F2F2F2']],
 ['Mint Condition',['#064E3B','#059669','#6EE7B7','#A7F3D0','#ECFDF5']],
 ['Berry Crush',['#4A1942','#893168','#C65B7C','#E7A4B4','#FBE4E8']]
];
let palettes = seed.map((p,i)=>({id:'seed'+i,name:p[0],colors:p[1]}));
let favorites = JSON.parse(localStorage.getItem('cs-favorites')||'[]');
let current = [...seed[0][1]], currentName='Ocean Depths', page='library', theme=localStorage.getItem('cs-theme')||'dark', extracted=[];
document.documentElement.dataset.theme=theme;
function saveFav(){localStorage.setItem('cs-favorites',JSON.stringify(favorites));$('#favCount').textContent=favorites.length;}
function hexToRgb(h){h=h.replace('#','');return [0,2,4].map(i=>parseInt(h.slice(i,i+2),16));}
function rgbToHex(r,g,b){return '#'+[r,g,b].map(v=>Math.max(0,Math.min(255,Math.round(v))).toString(16).padStart(2,'0')).join('').toUpperCase();}
function hslToHex(h,s,l){s/=100;l/=100;const k=n=>(n+h/30)%12,a=s*Math.min(l,1-l),f=n=>l-a*Math.max(-1,Math.min(k(n)-3,Math.min(9-k(n),1)));return rgbToHex(f(0)*255,f(8)*255,f(4)*255);}
function luminance(hex){const c=hexToRgb(hex).map(v=>v/255).map(v=>v<=.04045?v/12.92:((v+.055)/1.055)**2.4);return .2126*c[0]+.7152*c[1]+.0722*c[2];}
function contrast(a,b){let x=luminance(a),y=luminance(b);return ((Math.max(x,y)+.05)/(Math.min(x,y)+.05)).toFixed(2);}
function copy(t){navigator.clipboard?.writeText(t);toast('Copied '+t);}
function toast(t){let n=document.createElement('div');n.textContent=t;n.style='position:fixed;bottom:25px;right:28px;background:var(--accent2);color:white;padding:12px 18px;border-radius:9px;z-index:99;box-shadow:var(--shadow)';document.body.append(n);setTimeout(()=>n.remove(),1800);}
function setPage(p){page=p;$$('.nav-item[data-page]').forEach(b=>b.classList.toggle('active',b.dataset.page===p));$('#pageTitle').textContent=({'library':'Palette library','gradient':'Gradient studio','extractor':'Image colour extractor','generator':'AI palette generator','preview':'Live website preview','wheel':'Colour wheel','shades':'Shades generator','contrast':'Contrast checker','favorites':'Your favourites'})[p];render();}
function card(p){return `<article class="palette-card"><div class="swatches">${p.colors.map(c=>`<div class="swatch" style="background:${c}" data-copy="${c}" title="${c}"></div>`).join('')}</div><div class="card-meta"><b>${p.name}</b><div class="mini-actions"><button data-use="${p.id}">Use</button><button data-fav="${p.id}">${favorites.some(x=>x.id===p.id)?'♥':'♡'}</button></div></div><div class="hex-row">${p.colors.map(c=>`<span class="hex-chip">${c}</span>`).join('')}</div></article>`;}
function setCurrent(name,colors){current=[...colors];currentName=name;}
function paletteExport(format='css'){if(format==='tailwind')return `// tailwind.config.js\nmodule.exports = { theme: { extend: { colors: { '${currentName.toLowerCase().replace(/[^a-z0-9]+/g,'-')}': { ${current.map((c,i)=>`'${(i+1)*100}': '${c}'`).join(', ')} } } } } };`;return `:root {\n${current.map((c,i)=>`  --color-${i+1}: ${c};`).join('\n')}\n}`;}
async function exportCurrent(){let format=prompt('Export format: css or tailwind','css');if(!format)return;format=format.toLowerCase();if(!['css','tailwind'].includes(format)){toast('Choose css or tailwind');return;}let result=await window.studio.saveText({suggestedName:`${currentName.replace(/\s+/g,'-').toLowerCase()}.${format==='css'?'css':'js'}`,content:paletteExport(format)});if(!result.canceled)toast('Exported successfully');}
function render(){const c=$('#content');
if(page==='library'||page==='favorites'){let list=page==='favorites'?favorites:palettes;c.innerHTML=`<div class="section-head"><div><h2>${page==='favorites'?'Saved collections':'Explore curated palettes'}</h2><div class="muted" style="margin-top:5px">${list.length} colour collections · Click a swatch to copy its HEX</div></div><div class="toolbar"><input id="search" class="search" placeholder="Search palettes..."><button class="btn" id="random">✳ Surprise me</button></div></div><div class="grid" id="cards">${list.map(card).join('')||'<div class="empty">No favourites yet. Save palettes with the ♡ button.</div>'}</div>`;
$('#search').oninput=e=>{$('#cards').innerHTML=list.filter(p=>p.name.toLowerCase().includes(e.target.value.toLowerCase())||p.colors.some(x=>x.toLowerCase().includes(e.target.value.toLowerCase()))).map(card).join('')||'<div class="empty">No palettes found.</div>';wireCards();};$('#random').onclick=()=>{let p=palettes[Math.floor(Math.random()*palettes.length)];setCurrent(p.name,p.colors);toast('Try '+p.name);};wireCards();}
if(page==='gradient'){c.innerHTML=`<div class="two-col"><div class="panel"><h3>Gradient controls</h3><label class="field">Gradient type<select id="gradType"><option value="linear">Linear</option><option value="radial">Radial</option></select></label><label class="field">Angle <input id="angle" type="range" min="0" max="360" value="135"></label><div class="stops" id="stops"></div><div class="toolbar" style="margin-top:15px"><button class="btn-secondary" id="addStop">＋ Add colour</button><button class="btn" id="copyGrad">Copy CSS</button></div></div><div class="panel"><h3>Live gradient</h3><div class="big-preview" id="gradientPreview"><h2>Colour in motion.</h2><span>Beautiful blends, made simple.</span></div><pre id="gradCode" class="muted" style="white-space:pre-wrap;font-size:11px"></pre></div></div>`;
let stops=['#7C3AED','#EC4899','#F59E0B'];function update(){let type=$('#gradType').value,angle=$('#angle').value;let css=type==='linear'?`linear-gradient(${angle}deg, ${stops.join(', ')})`:`radial-gradient(circle, ${stops.join(', ')})` ;$('#gradientPreview').style.background=css;$('#gradCode').textContent=`background: ${css};`;$('#stops').innerHTML=stops.map((s,i)=>`<div class="stop"><input type="color" value="${s}" data-stop="${i}"><span>${s}</span>${stops.length>2?`<button data-remove="${i}" class="mini-actions">×</button>`:''}</div>`).join('');$$('[data-stop]').forEach(x=>x.oninput=e=>{stops[+e.target.dataset.stop]=e.target.value.toUpperCase();update();});$$('[data-remove]').forEach(x=>x.onclick=()=>{stops.splice(+x.dataset.remove,1);update();});}
$('#gradType').onchange=update;$('#angle').oninput=update;$('#addStop').onclick=()=>{if(stops.length<6){stops.push('#22C55E');update();}};$('#copyGrad').onclick=()=>copy($('#gradCode').textContent);update();}
if(page==='extractor'){c.innerHTML=`<div class="panel"><div class="section-head"><div><h2>Extract a palette from an image</h2><div class="muted">Image processing stays on your computer.</div></div><button class="btn" id="pickImage">＋ Choose image</button></div><div id="imageArea" class="empty">Choose a JPG, PNG or WEBP image to extract its dominant colours.</div><canvas id="imageCanvas" style="display:none"></canvas><div id="extractedColors" class="grid" style="margin-top:18px"></div></div>`;$('#pickImage').onclick=async()=>{let path=await window.studio.openImage();if(!path)return;let src=await window.studio.readImage(path),img=new Image();img.onload=()=>{let cv=$('#imageCanvas'),ctx=cv.getContext('2d');cv.width=100;cv.height=100;ctx.drawImage(img,0,0,100,100);let data=ctx.getImageData(0,0,100,100).data,buckets={};for(let i=0;i<data.length;i+=16){let r=Math.round(data[i]/32)*32,g=Math.round(data[i+1]/32)*32,b=Math.round(data[i+2]/32)*32,k=rgbToHex(r,g,b);buckets[k]=(buckets[k]||0)+1;}extracted=Object.entries(buckets).sort((a,b)=>b[1]-a[1]).slice(0,5).map(x=>x[0]);$('#imageArea').innerHTML=`<img src="${src}" style="max-width:100%;max-height:260px;object-fit:contain;border-radius:9px">`;$('#extractedColors').innerHTML=extracted.map(x=>`<div class="panel" style="padding:10px"><div style="height:55px;border-radius:7px;background:${x}"></div><b>${x}</b><button class="mini-actions" data-copy="${x}">Copy</button></div>`).join('');wireCopy();setCurrent('Image extraction',extracted);};img.src=src;};}
if(page==='generator'){c.innerHTML=`<div class="two-col"><div class="panel"><h3>Describe your colour mood</h3><label class="field">Prompt<textarea id="prompt" placeholder="e.g. luxury coffee brand, warm, earthy, elegant"></textarea></label><label class="field">Palette style<select id="mood"><option>Balanced</option><option>Pastel</option><option>Vibrant</option><option>Dark</option><option>Earthy</option><option>Minimal</option></select></label><button class="btn" id="generate">✳ Generate palette</button><p class="notice">Built-in prompt-based generator. No API key or internet connection required.</p></div><div class="panel"><h3>Your generated palette</h3><div id="generated" class="empty">Your palette will appear here.</div></div></div>`;
$('#generate').onclick=()=>{let prompt=$('#prompt').value.toLowerCase(),mood=$('#mood').value;let sets={Pastel:['#FADADD','#CDEAC0','#CDE7F0','#E8DFF5','#FFF1C1'],Vibrant:['#FF3D71','#FFB800','#00C2A8','#4361EE','#9B5DE5'],Dark:['#111827','#1F2937','#374151','#6D28D9','#A78BFA'],Earthy:['#493323','#805B45','#B08968','#DDB892','#E6CCB2'],Minimal:['#171717','#525252','#A3A3A3','#D4D4D4','#FAFAFA'],Balanced:['#264653','#2A9D8F','#E9C46A','#F4A261','#E76F51']};let colors=sets[mood];if(/ocean|sea|blue|tech/.test(prompt))colors=['#071952','#0B666A','#35A29F','#97FEED','#DDF7F0'];if(/coffee|luxury|warm|earth/.test(prompt))colors=['#352315','#654321','#A66A3F','#D9A066','#F1DFC5'];if(/pink|romantic|beauty/.test(prompt))colors=['#590D22','#A4133C','#FF4D6D','#FF8FA3','#FFF0F3'];setCurrent('Generated palette',colors);$('#generated').innerHTML=`<div class="swatches">${colors.map(x=>`<div class="swatch" style="background:${x}" data-copy="${x}"></div>`).join('')}</div><div class="hex-row">${colors.map(x=>`<span class="hex-chip">${x}</span>`).join('')}</div><button class="btn" style="margin-top:16px" id="saveGenerated">♡ Save to favourites</button>`;$('#saveGenerated').onclick=()=>addFavorite('Generated palette',colors);wireCopy();};}
if(page==='preview'){c.innerHTML=`<div class="section-head"><div><h2>Test your palette in context</h2><div class="muted">Select a saved palette to update this mini website.</div></div><select id="previewPalette" class="search">${palettes.map((p,i)=>`<option value="${i}">${p.name}</option>`).join('')}</select></div><div class="preview-site" id="sitePreview"><div class="preview-nav"><b id="pvBrand">NORTH / STUDIO</b><span id="pvLinks">Work　 About　 Contact</span></div><div class="preview-hero"><div class="eyebrow" id="pvEyebrow">DESIGN THAT FEELS DIFFERENT</div><h2 id="pvTitle">Build your next big idea.</h2><p>Thoughtful details. Beautiful experiences. Made for people.</p><span class="preview-cta" id="pvButton">Explore the collection</span></div></div><div class="panel" style="margin-top:18px"><h3>Current colours</h3><div id="pvSwatches" class="swatches"></div></div>`;function updatePreview(i){let colors=palettes[i].colors;setCurrent(palettes[i].name,colors);$('#sitePreview').style.background=colors[4];$('#pvBrand').style.color=colors[0];$('#pvLinks').style.color=colors[1];$('#pvEyebrow').style.color=colors[2];$('#pvTitle').style.color=colors[0];$('#pvButton').style.background=colors[1];$('#pvSwatches').innerHTML=colors.map(x=>`<div class="swatch" style="background:${x}" data-copy="${x}"></div>`).join('');wireCopy();}$('#previewPalette').onchange=e=>updatePreview(+e.target.value);updatePreview(0);}
if(page==='wheel'){c.innerHTML=`<div class="panel"><h3>Harmony explorer</h3><div class="wheel-layout"><div><div class="wheel" id="wheel"></div><div class="notice">Click anywhere on the wheel to choose a hue.</div></div><div><label class="field">Base colour<input id="wheelBase" type="color" class="color-input" value="#7C3AED"></label><label class="field">Harmony<select id="harmony"><option value="complement">Complementary</option><option value="triad">Triadic</option><option value="analogous">Analogous</option><option value="split">Split complementary</option></select></label><div id="harmonyColors" class="grid"></div></div></div></div>`;function update(){let base=$('#wheelBase').value,[r,g,b]=hexToRgb(base);let max=Math.max(r,g,b),min=Math.min(r,g,b),h=0,s=0,l=(max+min)/510,d=max-min;if(d){s=d/(255*(1-Math.abs(2*l-1)));if(max===r)h=60*(((g-b)/d)%6);else if(max===g)h=60*((b-r)/d+2);else h=60*((r-g)/d+4);}let offsets={complement:[0,180],triad:[0,120,240],analogous:[0,30,330],split:[0,150,210]}[$('#harmony').value];let colors=offsets.map(o=>hslToHex((h+o+360)%360,Math.max(45,s*100),Math.max(35,Math.min(65,l*100))));colors[0]=base;$('#harmonyColors').innerHTML=colors.map(x=>`<div class="panel" style="padding:10px"><div style="height:45px;background:${x};border-radius:7px"></div><b>${x}</b></div>`).join('');setCurrent('Colour harmony',colors);}$('#wheel').onclick=e=>{let r=e.currentTarget.getBoundingClientRect(),x=e.clientX-r.left-r.width/2,y=e.clientY-r.top-r.height/2,h=(Math.atan2(y,x)*180/Math.PI+360)%360;$('#wheelBase').value=hslToHex(h,75,55);update();};$('#wheelBase').oninput=update;$('#harmony').onchange=update;update();}
if(page==='shades'){c.innerHTML=`<div class="panel"><h3>Generate a complete shade scale</h3><div class="toolbar"><label class="field" style="min-width:200px">Base colour<input type="color" id="shadeBase" class="color-input" value="#7C3AED"></label><label class="field" style="min-width:200px">Scale name<input id="shadeName" value="brand"></label><button class="btn" id="shadeExport">Export CSS</button></div><div id="shadeOutput"></div></div>`;function update(){let base=$('#shadeBase').value,[r,g,b]=hexToRgb(base),steps=[50,100,200,300,400,500,600,700,800,900,950],colors=steps.map((s)=>{let t=(s-500)/450,target=t<0?255:0,f=Math.abs(t);return rgbToHex(r+(target-r)*f,g+(target-g)*f,b+(target-b)*f);});$('#shadeOutput').innerHTML=`<div class="shade-strip">${colors.map((x,i)=>`<div class="shade" style="background:${x};color:${i<3?'#222':'#fff'}" data-copy="${x}">${steps[i]}</div>`).join('')}</div><div class="hex-row">${colors.map(x=>`<span class="hex-chip">${x}</span>`).join('')}</div>`;window.shadeCSS=`:root {\\n${colors.map((x,i)=>`  --${$('#shadeName').value}-${steps[i]}: ${x};`).join('\\n')}\\n}`;setCurrent('Shade scale',colors);}$('#shadeBase').oninput=update;$('#shadeName').oninput=update;$('#shadeExport').onclick=async()=>{let r=await window.studio.saveText({suggestedName:'colour-shades.css',content:window.shadeCSS});if(!r.canceled)toast('Exported shades');};update();}
if(page==='contrast'){c.innerHTML=`<div class="two-col"><div class="panel"><h3>Choose foreground and background</h3><label class="field">Text colour<input type="color" id="fg" class="color-input" value="#FFFFFF"></label><label class="field">Background colour<input type="color" id="bg" class="color-input" value="#7C3AED"></label><div class="toolbar"><button class="btn-secondary" id="swap">⇄ Swap colours</button><button class="btn-secondary" id="contrastCopy">Copy pair</button></div></div><div class="panel"><h3>Accessibility preview</h3><div class="contrast-sample" id="contrastSample">Readable by design.</div><div class="result" id="contrastResult"></div></div></div>`;function update(){let a=$('#fg').value,b=$('#bg').value,v=contrast(a,b),n=+v;$('#contrastSample').style.color=a;$('#contrastSample').style.background=b;$('#contrastResult').innerHTML=`<div style="font-size:25px;font-weight:700">${v}:1</div><div class="${n>=4.5?'good':'bad'}">${n>=7?'AAA · Excellent':n>=4.5?'AA · Pass':n>=3?'Large text only · AA':'Fails WCAG AA'}</div><div class="muted" style="margin-top:6px">WCAG AA normal text: 4.5:1 · Large text: 3:1 · AAA normal text: 7:1</div>`;setCurrent('Contrast pair',[a,b]);}$('#fg').oninput=update;$('#bg').oninput=update;$('#swap').onclick=()=>{let a=$('#fg').value;$('#fg').value=$('#bg').value;$('#bg').value=a;update();};$('#contrastCopy').onclick=()=>copy(`Text: ${$('#fg').value}, Background: ${$('#bg').value}, Ratio: ${contrast($('#fg').value,$('#bg').value)}:1`);update();}
}
function wireCopy(){$$('[data-copy]').forEach(x=>x.onclick=()=>copy(x.dataset.copy));}
function addFavorite(name,colors){let id='fav-'+Date.now();favorites.unshift({id,name,colors:[...colors]});saveFav();toast('Added to favourites');}
function wireCards(){wireCopy();$$('[data-use]').forEach(b=>b.onclick=()=>{let p=palettes.find(x=>x.id===b.dataset.use)||favorites.find(x=>x.id===b.dataset.use);if(p){setCurrent(p.name,p.colors);toast('Current palette: '+p.name);}});$$('[data-fav]').forEach(b=>b.onclick=()=>{let p=palettes.find(x=>x.id===b.dataset.fav)||favorites.find(x=>x.id===b.dataset.fav);if(!p)return;if(favorites.some(x=>x.id===p.id)){favorites=favorites.filter(x=>x.id!==p.id);}else{favorites.unshift({...p,id:'fav-'+Date.now()});}saveFav();render();});}
$('#nav').addEventListener('click',e=>{let b=e.target.closest('[data-page]');if(b)setPage(b.dataset.page);});$$('.side-bottom [data-page]').forEach(b=>b.onclick=()=>setPage(b.dataset.page));
$('#themeToggle').onclick=()=>{theme=theme==='dark'?'light':'dark';document.documentElement.dataset.theme=theme;localStorage.setItem('cs-theme',theme);};
$('#exportTop').onclick=exportCurrent;saveFav();render();
